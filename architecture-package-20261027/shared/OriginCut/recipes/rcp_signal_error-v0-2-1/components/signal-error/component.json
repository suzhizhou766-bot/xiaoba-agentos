  "runtime": "web-generator",
  "entry": "src/main.js",
  "generatorApiVersion": 2,
  "graphics": {
    "backend": "webgl2",
    "library": {
      "id": "origin-scene",
      "apiVersion": 2
    }
  },
  "logicalSurface": {
    "width": 1920,
    "height": 1080
  },
  "sourceDuration": {
    "ticks": 4000000,
    "timescale": 1000000
  },
  "output": {
    "background": {
      "mode": "solid",
      "color": "#111415"
    },
    "surface": "rgba"
