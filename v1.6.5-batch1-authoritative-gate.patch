+    def simulate_review_ingress_flow(self, cand, dsh_verdict="PASS", peer_verdict="PASS"):
+        """模拟真实的审查接入流程并产出经过 attestation 确认的双审回执。"""
+        evidence_item = {
+            "ref": "trial://execution-log/run-01",
