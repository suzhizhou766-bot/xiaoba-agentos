+
+    def test_round2_pass_without_valid_diff_blocks_qualification_without_retiring(self):
+        """次轮验证通过但缺少有效差异材料：保留通过证据，阻断待终审，补齐后重新检查资格，不新增验证轮次，绝不退役。"""
